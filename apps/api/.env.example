# --- LLM : le seul élément qui demande une clé --------------------------------
# groq   -> https://console.groq.com/keys        GRATUIT, sans CB, le plus rapide
# google -> https://aistudio.google.com/apikey   GRATUIT, quota quotidien large
# ollama -> https://ollama.com                   GRATUIT, 100% local, aucune clé
# openai -> https://platform.openai.com/api-keys PAYANT à l'usage
LLM_PROVIDER=groq

GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Surcharge du modèle, tous providers confondus (laisser vide pour le défaut du
# provider choisi). Les défauts et la liste proposée dans l'UI vivent dans
# agent/model.py (PROVIDER_MODELS) — vérifiés le 25-07-2026 :
#   groq   : openai/gpt-oss-120b
#   google : gemini-3.6-flash
#   ollama : qwen3:8b            (le tag doit être `ollama pull` en local)
#   openai : gpt-5.6-luna
LLM_MODEL=
LLM_TEMPERATURE=0

# Depuis un conteneur, Ollama tourne sur l'hôte :
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Journalisation -----------------------------------------------------------
# Tout part sur stdout : `make logs-api`.
# LOG_LEVEL  : niveau du canal `agent` (DEBUG|INFO|WARNING|ERROR). Les bibliothèques
#              restent à WARNING quoi qu'il arrive.
# LOG_FORMAT : text (humain, défaut) | json (une ligne JSON par message, pour `jq`)
# LOG_LEVELS : niveaux par canal, pour ne bavarder que là où on enquête.
#              ex. LOG_LEVELS=agent.stream=DEBUG,agent.db=ERROR
# LOG_ACCESS : off pour couper la ligne par requête d'uvicorn (bruyante en debug)
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_LEVELS=
LOG_ACCESS=on

# --- Serveur ------------------------------------------------------------------
# Origines autorisées en CORS (le front dev passe par le proxy Vite, donc same-origin)
CORS_ORIGIN=http://localhost:4311

# --- Authentification (RBAC natif) --------------------------------------------
# AUTH_SECRET : clé de signature des jetons de session. 32 caractères MINIMUM.
#   Générez-la : openssl rand -base64 48
#   Laissée vide, une clé éphémère est tirée au démarrage : ça marche, mais tout
#   le monde est déconnecté à chaque redémarrage du conteneur.
#   La faire tourner déconnecte immédiatement toutes les sessions — c'est le seul
#   moyen de révoquer un accès sans attendre l'expiration.
AUTH_SECRET=
# Session = jeton d'ACCÈS court + jeton de REFRESH long, révocable (table `sessions`).
#
# AUTH_ACCESS_TTL_MINUTES : durée du jeton d'accès (auto-porteur, vérifié SANS base).
#   C'est AUSSI le délai maximal avant qu'un compte désactivé ou une session révoquée
#   perde réellement l'accès — et donc la durée pendant laquelle le chat survit à une
#   panne Postgres. Court = révocation rapide mais survie-panne courte. 15 min est le
#   standard ; le monter rapproche du modèle « jeton long » (révocation lente).
AUTH_ACCESS_TTL_MINUTES=15
# AUTH_REFRESH_TTL_DAYS : durée de vie d'un refresh inactif = fenêtre du « reste
#   connecté ». Chaque refresh le fait tourner (rotation) ; le rejeu d'un jeton déjà
#   pivoté révoque toutes les sessions du compte (vol présumé).
AUTH_REFRESH_TTL_DAYS=14
# 1 en production (HTTPS obligatoire). À 1 en dev sur http://localhost, le
# navigateur ne renverrait jamais le cookie et la connexion semblerait échouer.
AUTH_COOKIE_SECURE=0

# Premier administrateur, créé au démarrage UNIQUEMENT si la table est vide.
# Sans ces deux valeurs, aucun compte n'existe et personne ne peut se connecter :
# créez-en un avec `make user-create EMAIL=... ROLE=admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mot de passe des comptes de DÉMONSTRATION créés par `make seed`. Vide = valeur
# par défaut de `agent/core/seed.py`, celle que l'écran de connexion propose en
# un clic sur « / » en développement.
# Le définir ici DÉSACTIVE cet autofill : les comptes existeront avec un autre
# mot de passe que celui connu du front.
# `make seed` refuse de s'exécuter si AUTH_COOKIE_SECURE est actif.
SEED_PASSWORD=

# --- RAG : index documentaire -------------------------------------------------
# Base vectorielle dédiée (pgvector). Séparée de DATABASE_URL à dessein : on peut
# la vider et tout réindexer sans jamais toucher aux conversations.
RAG_DATABASE_URL=postgresql://rag:rag@ragdb:5432/rag

# Volume des sources déposées depuis Configuration > Sources. Il doit être
# persistant et inscriptible par l'API ; le compose monte déjà ce chemin.
INGESTION_DATA_DIR=/data/ingestion
# Taille maximale d'un fichier reçu par l'API (octets), contrôlée pendant le
# streaming vers disque pour ne jamais charger un gros document en mémoire.
INGESTION_MAX_FILE_BYTES=52428800

# EMBEDDING_PROVIDER : registre de fournisseurs, voir agent/core/rag/embed.py
#   openai : le vrai, facturé à l'INGESTION (pas à la requête) ;
#   ollama : local, gratuit, sans clé — demande un serveur joignable et le modèle
#            déjà tiré. Le seul qui garde le corpus sur la machine ;
#   hash   : déterministe, sans réseau. Exerce toute la chaîne mais la PERTINENCE
#            ne veut RIEN dire. C'est ce que les tests utilisent.
# En ajouter un : une classe, un `register()`, rien d'autre à toucher.
EMBEDDING_PROVIDER=openai
# Vide = valeur par défaut du code. À CONFRONTER au catalogue OpenAI en vigueur :
# les noms de modèles d'embedding changent, et un nom périmé ne se voit qu'à
# l'exécution.
EMBEDDING_MODEL=
# Dimension des vecteurs. FIGÉE DANS LE SCHÉMA : la changer impose de tout
# réindexer (`make rag-reset && make ingest`). Maximum 2000 pour un index HNSW.
EMBEDDING_DIM=1536
# Tarif du modèle, en dollars par million de tokens, pour l'estimation affichée
# par `make ingest`. Vide = aucun coût affiché (mieux qu'un coût faux).
EMBEDDING_COST_PER_MTOK=

# Garde-fou : nombre maximal de fragments vectorisés en une exécution. Le coût
# d'un RAG est à l'INGESTION, et une boucle sur un gros corpus ne se voit pas
# passer. Vérifié après le découpage, donc avant la moindre facturation.
RAG_MAX_CHUNKS_PER_RUN=2000
# Fragments rendus au modèle par recherche, et taille du vivier avant fusion.
RAG_TOP_K=5
RAG_CANDIDATES=30

# --- RAG : profil d'INDEXATION ------------------------------------------------
# Ces deux réglages déterminent ce qui a été vectorisé. Les changer impose de
# réindexer — l'ingestion le détecte seule et refait les documents concernés.
#
# Taille visée d'un fragment, en tokens estimés. Trop grand, un fragment mélange
# plusieurs sujets et son vecteur devient une moyenne floue ; trop petit, la
# réponse est coupée en deux et aucune moitié ne répond seule.
RAG_CHUNK_TOKENS=300
RAG_CHUNK_OVERLAP=1
# Préfixe chaque fragment par son contexte documentaire (type, client, référence,
# chemin de titres) avant vectorisation. Structurel, donc gratuit — contrairement
# à la variante générée par LLM, qui coûte un appel par fragment à CHAQUE
# réindexation.
RAG_CONTEXTUAL=0

# --- RAG : chaîne de RECHERCHE ------------------------------------------------
# Tous ablatables à chaud : `make ablation` mesure ce que chacun apporte.
#
# `modern-hyde-v1` active atomiquement la combinaison mesurée ; les réglages
# détaillés ci-dessous servent au profil `custom` et aux expériences d'ablation.
RAG_PROFILE=custom
#
# Branches actives. Les couper toutes les deux est une erreur, pas un mode.
RAG_DENSE=1
RAG_SPARSE=1
# Poids du lexical dans la fusion RRF, la dense valant 1. CALIBRÉ sur le corpus
# de démonstration (1,0 → 80,6 % de rappel ; 0,3 → 89,2 %), à recalibrer ailleurs.
# À poids égal, un récupérateur faible mais toujours plein fait descendre les
# meilleurs résultats de l'autre : la RRF « sans calibration » cache ce réglage.
RAG_SPARSE_WEIGHT=0.3

# Reformulations générées avant recherche. 0 désactive. Coûte un appel de modèle
# par recherche et n fois plus de requêtes SQL, contre ~6 points de rappel.
RAG_MULTI_QUERY=0
# HyDE : génère N documents hypothétiques, les encode comme des documents et
# moyenne leurs vecteurs avec celui de la question. 0 désactive ; maximum 8.
# Le texte hypothétique ne passe jamais dans le lexical, les citations ou la
# réponse. 0,7 est la température de l'implémentation originale des auteurs.
RAG_HYDE_DOCUMENTS=0
RAG_HYDE_INCLUDE_QUERY=1
RAG_HYDE_TEMPERATURE=0.7
# Reclassement des candidats par un modèle qui LIT les passages : none | llm.
# C'est lui qui produit une échelle de score interprétable, donc lui qui rend
# l'abstention possible.
RAG_RERANK=none
RAG_RERANK_POOL=20
# Seuil d'abstention, sur l'échelle 0–10 du reclasseur. VIDE = aucun seuil, ce qui
# n'est pas « seuil à zéro » : c'est « aucun seuil n'a été calibré ». Sans lui, le
# système répond TOUJOURS quelque chose, y compris le contrat d'un autre client.
#
# La valeur ne se CHOISIT pas : `make calibrate` la déduit d'un critère écrit, en
# balayant toute la plage sur une seule passe de reclassement. Sur le corpus de
# profil `modern-hyde-v1`, le corpus de démonstration et `gpt-5.6-luna`, elle vaut
# 4,5. Toute modification du corpus ou du modèle impose `make calibrate`.
RAG_MIN_RERANK_SCORE=
# Fragments voisins recollés autour de chaque résultat (small-to-big). Change le
# texte rendu, pas le classement — donc invisible au rappel et au MRR.
RAG_NEIGHBOURS=0

# Modèle des tâches AUXILIAIRES de la recherche (reclassement, reformulation),
# distinct de celui du chat. Vide = celui du chat. Trier une liste ne demande pas
# un modèle de raisonnement, et sa latence s'ajoute à chaque recherche.
RAG_LLM_PROVIDER=
RAG_LLM_MODEL=
